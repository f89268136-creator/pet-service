.detail {
  min-height: 100vh;
}

.hero {
  height: 420rpx;
  background: linear-gradient(160deg, #e95f3c 0%, #f4876a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-image {
  width: 100%;
  height: 420rpx;
  display: block;
}

.hero-fallback {
  width: 180rpx;
  height: 180rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
  font-size: 84rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.intro-card {
  margin-top: -60rpx;
  position: relative;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #20232a;
  flex: 1;
  margin-right: 20rpx;
}

.name-price {
  font-size: 44rpx;
  flex-shrink: 0;
}

.tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.desc-title,
.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #30343b;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 27rpx;
  color: #5c6169;
  line-height: 1.8;
}

.info-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff1ec;
  color: #e95f3c;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: 26rpx;
  color: #6f747d;
  line-height: 1.7;
}
