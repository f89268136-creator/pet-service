.service-card {
  display: flex;
  align-items: center;
}

.service-thumb {
  width: 116rpx;
  height: 116rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff2ec 0%, #ffddd1 100%);
  color: #d98d75;
  font-size: 46rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  min-width: 0;
}

.service-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #20232a;
}

.service-price {
  margin-top: 8rpx;
  font-size: 34rpx;
}

.arrow {
  margin-left: 12rpx;
  color: #c3c7cd;
  font-size: 34rpx;
}

.link {
  color: #e95f3c;
}

.slot-block {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f2f4;
}

.slot-head {
  margin-bottom: 18rpx;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
}

.slot-chip {
  width: calc(33.33% - 12rpx);
  margin: 0 12rpx 14rpx 0;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eceef1;
  background: #fafbfc;
  text-align: center;
}

.slot-chip:nth-child(3n) {
  margin-right: 0;
}

.slot-chip.active {
  border-color: #e95f3c;
  background: #fff5f1;
}

.slot-chip.disabled {
  opacity: 0.45;
}

.slot-time {
  font-size: 25rpx;
  font-weight: 600;
  color: #30343b;
}

.slot-chip.active .slot-time {
  color: #e95f3c;
}

.slot-left {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa0a8;
}

.slot-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #a0a5ad;
}

.remark-block {
  position: relative;
  padding-top: 26rpx;
}

.remark-label {
  display: block;
  margin-bottom: 14rpx;
}

.remark-input {
  width: 100%;
  height: 150rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #30343b;
}

.remark-count {
  position: absolute;
  right: 16rpx;
  bottom: 10rpx;
  font-size: 20rpx;
  color: #b3b8c0;
}

.tips {
  padding: 8rpx 8rpx 24rpx;
}

.tip-line {
  font-size: 22rpx;
  color: #a0a5ad;
  line-height: 1.8;
}
