<view class="appointment-page">
  <scroll-view class="tab-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="tab-list">
      <view
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="label"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="page">
    <view wx:if="{{list.length === 0 && loading}}" class="loading-tip">正在加载预约...</view>
    <view wx:elif="{{list.length === 0}}" class="empty">
      <view class="empty-title">还没有预约记录</view>
      <view>去首页选择一项服务，给毛孩子安排一次护理吧</view>
    </view>

    <view
      class="order-card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="order-head">
        <text class="order-no">{{item.number}}</text>
        <text class="tag tag-{{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="order-body">
        <view class="order-thumb">{{item.initial}}</view>
        <view class="order-main">
          <view class="order-name ellipsis">{{item.serviceName}}</view>
          <view class="order-meta">{{item.serviceDate}} {{item.serviceTime}}</view>
          <view class="order-meta ellipsis">{{item.storeName}}</view>
        </view>
        <view class="order-price">
          <text class="price-symbol">¥</text>{{item.amountText}}
        </view>
      </view>

      <view class="order-foot">
        <text class="pet-line ellipsis">{{item.petLine}}</text>
        <view class="order-actions">
          <button
            wx:if="{{item.status === 1}}"
            class="btn btn-sm btn-ghost"
            data-id="{{item.id}}"
            catchtap="cancelOrder"
          >取消预约</button>
          <button class="btn btn-sm btn-light" data-id="{{item.id}}" catchtap="openDetail">查看详情</button>
        </view>
      </view>
    </view>

    <view wx:if="{{list.length > 0 && loading}}" class="load-more">加载中...</view>
    <view wx:elif="{{list.length > 0 && finished}}" class="load-more">没有更多预约了</view>
  </view>
</view>
