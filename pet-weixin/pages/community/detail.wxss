.comment-page {
  padding-bottom: 150rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd7c9 0%, #ffb39c 100%);
  color: #b84425;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #30343b;
}

.post-time {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #a0a5ad;
}

.post-tags {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.post-content {
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #30343b;
  word-break: break-all;
}

.image-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.feed-image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f3f4f6;
}

.feed-image:nth-child(3n) {
  margin-right: 0;
}

.post-foot {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  align-items: center;
}

.feed-action {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a8f99;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.feed-action.liked {
  color: #e95f3c;
}

.feed-action.liked .action-icon {
  background: #e95f3c;
  color: #ffffff;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #30343b;
  margin-bottom: 16rpx;
}

.comment-empty {
  padding: 50rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #a0a5ad;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6f747d;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-name {
  font-size: 25rpx;
  color: #5c6169;
  font-weight: 600;
}

.comment-time {
  font-size: 21rpx;
  color: #b3b8c0;
}

.comment-content {
  margin-top: 8rpx;
  font-size: 27rpx;
  color: #30343b;
  line-height: 1.6;
  word-break: break-all;
}

.comment-bar {
  display: flex;
  align-items: center;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 36rpx;
}
