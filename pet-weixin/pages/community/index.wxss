.top-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(32, 35, 42, 0.04);
}

.sort-tabs {
  display: flex;
  align-items: center;
}

.sort-item {
  position: relative;
  margin-right: 40rpx;
  font-size: 30rpx;
  color: #6f747d;
  padding: 8rpx 0;
}

.sort-item.active {
  color: #20232a;
  font-weight: 700;
}

.sort-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 36rpx;
  height: 6rpx;
  margin-left: -18rpx;
  border-radius: 3rpx;
  background: #e95f3c;
}

.publish-link {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: #fff1ec;
  color: #e95f3c;
  font-size: 25rpx;
  font-weight: 600;
}

.community-body {
  padding-top: 20rpx;
}

.post-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(32, 35, 42, 0.05);
}

.post-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd7c9 0%, #ffb39c 100%);
  color: #b84425;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #30343b;
}

.post-time {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #a0a5ad;
}

.post-tags {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.post-content {
  margin-top: 20rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #30343b;
  word-break: break-all;
}

.image-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.feed-image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f3f4f6;
}

.feed-image:nth-child(3n) {
  margin-right: 0;
}

.post-foot {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  align-items: center;
}

.feed-action {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a8f99;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.feed-action.liked {
  color: #e95f3c;
}

.feed-action.liked .action-icon {
  background: #e95f3c;
  color: #ffffff;
}

.action-count {
  min-width: 30rpx;
}
