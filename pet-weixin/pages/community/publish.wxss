.content-input {
  width: 100%;
  min-height: 260rpx;
  font-size: 29rpx;
  line-height: 1.8;
  color: #30343b;
}

.content-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #b3b8c0;
}

.arrow {
  margin-left: 12rpx;
  color: #c3c7cd;
  font-size: 34rpx;
}

.tips {
  padding: 8rpx 8rpx 24rpx;
}

.tip-line {
  font-size: 22rpx;
  color: #a0a5ad;
  line-height: 1.8;
}
