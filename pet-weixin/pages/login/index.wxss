.login {
  min-height: 100vh;
  background: linear-gradient(180deg, #e95f3c 0%, #f4876a 38%, #f5f5f7 38%, #f5f5f7 100%);
  padding: 0 40rpx 60rpx;
}

.hero {
  padding: 90rpx 8rpx 60rpx;
  color: #ffffff;
}

.hero-mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.slogan {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.login-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 40rpx;
  box-shadow: 0 20rpx 50rpx rgba(32, 35, 42, 0.12);
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #20232a;
}

.card-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 1.6;
}

.login-btn {
  margin-top: 40rpx;
}

.or {
  display: flex;
  align-items: center;
  margin: 40rpx 0 28rpx;
}

.or .line {
  flex: 1;
  height: 1rpx;
  background: #eceef1;
}

.or-text {
  margin: 0 20rpx;
  font-size: 24rpx;
  color: #a0a5ad;
}

.field {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #20232a;
}

.code-row {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 0 12rpx 0 28rpx;
  margin-top: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.hint {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #a0a5ad;
  line-height: 1.7;
}
