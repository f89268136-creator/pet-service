.pet-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(32, 35, 42, 0.05);
}

.pet-head {
  display: flex;
  align-items: center;
}

.pet-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffd7c9 0%, #ffb39c 100%);
  color: #b84425;
  font-size: 46rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.pet-title {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #20232a;
}

.pet-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.pet-info {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
  padding: 18rpx 0 8rpx;
  border-top: 1rpx solid #f2f3f5;
}

.info-cell {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.cell-label {
  width: 88rpx;
  font-size: 24rpx;
  color: #9aa0a8;
}

.cell-value {
  font-size: 25rpx;
  color: #30343b;
}

.pet-note {
  margin-top: 8rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f8f9fb;
  font-size: 24rpx;
  color: #6f747d;
  line-height: 1.6;
}

.pet-actions {
  margin-top: 22rpx;
  display: flex;
  justify-content: flex-end;
}

.pet-actions .btn + .btn {
  margin-left: 16rpx;
}
