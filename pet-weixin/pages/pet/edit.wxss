.arrow {
  margin-left: 12rpx;
  color: #c3c7cd;
  font-size: 34rpx;
}

.gender-group {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.gender-option {
  display: flex;
  align-items: center;
  margin-left: 26rpx;
}

.gender-text {
  margin-left: 6rpx;
  font-size: 26rpx;
  color: #30343b;
}

.clear-link {
  font-size: 24rpx;
  color: #e95f3c;
  padding-left: 16rpx;
}

.note-label {
  display: block;
  margin-bottom: 14rpx;
}

.note-input {
  width: 100%;
  height: 180rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #30343b;
}
