.home {
  min-height: 100vh;
  position: relative;
}

.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(160deg, #e95f3c 0%, #f4876a 100%);
}

.home-body {
  position: relative;
  padding-top: 28rpx;
}

.store-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx 28rpx 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(120, 48, 28, 0.16);
}

.store-top {
  display: flex;
  align-items: flex-start;
}

.store-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffd7c9 0%, #ffb39c 100%);
  color: #b84425;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.store-main {
  flex: 1;
  min-width: 0;
}

.store-name-row {
  display: flex;
  align-items: center;
}

.store-name {
  max-width: 400rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #20232a;
}

.status-pill {
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-pill.open {
  background: #e9f8ef;
  color: #2f9e58;
}

.status-pill.closed {
  background: #f1f2f4;
  color: #8a8f99;
}

.store-address {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6f747d;
}

.store-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9aa0a8;
  display: flex;
  align-items: center;
}

.store-meta .dot {
  margin: 0 10rpx;
}

.store-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eceef1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-desc {
  flex: 1;
  font-size: 24rpx;
  color: #8a8f99;
  margin-right: 20rpx;
}

.store-link {
  font-size: 24rpx;
  color: #e95f3c;
  flex-shrink: 0;
}

.quick-grid {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 12rpx;
  margin: 24rpx 0 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(32, 35, 42, 0.05);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.tone-a {
  background: linear-gradient(135deg, #ff9d7d 0%, #e95f3c 100%);
}

.tone-b {
  background: linear-gradient(135deg, #8fc7ff 0%, #4a8de0 100%);
}

.tone-c {
  background: linear-gradient(135deg, #ffd36e 0%, #f0a020 100%);
}

.tone-d {
  background: linear-gradient(135deg, #9fe3c2 0%, #43b581 100%);
}

.quick-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #30343b;
}

.quick-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a0a5ad;
}

.section-head {
  margin-top: 34rpx;
}

.cate-scroll {
  margin: 0 -24rpx 20rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.cate-list {
  display: inline-flex;
  padding-bottom: 8rpx;
}

.cate-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 30rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #5c6169;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(32, 35, 42, 0.04);
}

.cate-chip.active {
  background: #e95f3c;
  color: #ffffff;
  font-weight: 600;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.service-card {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(32, 35, 42, 0.05);
}

.service-thumb {
  width: 100%;
  height: 220rpx;
  background: #fdf1ec;
}

.service-image {
  width: 100%;
  height: 220rpx;
  display: block;
}

.thumb-fallback {
  width: 100%;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #d98d75;
  background: linear-gradient(135deg, #fff2ec 0%, #ffddd1 100%);
}

.service-body {
  padding: 20rpx;
}

.service-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #20232a;
}

.service-desc {
  margin-top: 8rpx;
  min-height: 64rpx;
  font-size: 23rpx;
  color: #8a8f99;
  line-height: 32rpx;
}

.service-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 32rpx;
}

.book-link {
  font-size: 24rpx;
  color: #e95f3c;
  background: #fff1ec;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
}

.package-scroll {
  margin: 0 -24rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.package-list {
  display: inline-flex;
  padding-bottom: 8rpx;
}

.package-card {
  width: 480rpx;
  margin-right: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: inline-flex;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(32, 35, 42, 0.05);
}

.package-thumb {
  width: 170rpx;
  flex-shrink: 0;
}

.package-image {
  width: 170rpx;
  height: 100%;
  min-height: 170rpx;
  display: block;
}

.package-initial {
  width: 170rpx;
  height: 100%;
  min-height: 170rpx;
  font-size: 52rpx;
}

.package-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
}

.package-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #20232a;
}

.package-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.package-price {
  margin-top: 16rpx;
  font-size: 32rpx;
}

.footer-tip {
  padding: 52rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b3b8c0;
}

.modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 22, 26, 0.5);
}

.modal-panel {
  position: relative;
  width: 620rpx;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #20232a;
}

.modal-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8f99;
}

.modal-list {
  margin: 20rpx 0;
  max-height: 46vh;
}

.pkg-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.pkg-name {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #30343b;
  font-weight: 500;
}

.pkg-copies {
  font-size: 24rpx;
  color: #e95f3c;
}

.pkg-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a8;
}

.modal-tip {
  font-size: 22rpx;
  color: #a0a5ad;
  line-height: 1.6;
  margin-bottom: 22rpx;
}
